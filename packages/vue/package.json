{
  "name": "viewake-vue",
  "version": "0.1.0",
  "description": "Vue 3 directive and plugin for Viewake.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "viewake": ">=0.1.0",
    "vue": ">=3.3"
  },
  "license": "MIT"
}
