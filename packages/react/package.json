{
  "name": "viewake-react",
  "version": "0.1.0",
  "description": "React and Next.js adapter for Viewake.",
  "author": "Viewake contributors",
  "homepage": "https://viewake.github.io/viewake/frameworks/react-next",
  "bugs": {
    "url": "https://github.com/viewake/viewake/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viewake/viewake.git",
    "directory": "packages/react"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "viewake": "^0.1.0"
  },
  "keywords": [
    "animation",
    "scroll",
    "react",
    "nextjs",
    "intersection-observer"
  ],
  "license": "MIT"
}
